# Copy to .env or .env.local and fill in. ./start.sh (server and demo) loads both automatically.
# Both are git-ignored: never commit a real key.

# Which model makes refund decisions: mock | ollama | gemini
CHANGSUPPORT_LLM_PROVIDER=gemini

# Google AI Studio key (serves both Gemma and Gemini). Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemma 4 31B. Faster option: gemma-4-26b-a4b-it. A Gemini model id such as gemini-2.5-flash also works.
GEMINI_MODEL=gemma-4-31b-it
GEMINI_TIMEOUT=90
# Retries when the model answers "busy" (429/503), which hosted Gemma does often.
GEMINI_MAX_RETRIES=3
# Leave empty to let Gemma think before answering (better judgment, ~25s on 31B).
# Set to "minimal" to turn thinking off (~2x faster).
GEMINI_THINKING_LEVEL=
# If the API errors (bad key, quota, network), answer with the mock LLM instead of failing.
GEMINI_FALLBACK_TO_MOCK=true

# The orchestrator's planning, routing and reply calls. Their output is checked in code,
# so thinking is off by default ("minimal"): about twice as fast. Set empty to let them think.
ORCHESTRATOR_THINKING_LEVEL=minimal
# Model for those calls. Empty = gemma-4-26b-a4b-it when GEMINI_MODEL is a Gemma 4
# (about 3s a call versus 20s+ on the 31B), otherwise GEMINI_MODEL.
ORCHESTRATOR_MODEL=
# Per-call ceiling in seconds; on timeout the claim continues with the standard plan.
ORCHESTRATOR_TIMEOUT=20
ORCHESTRATOR_MAX_RETRIES=2
